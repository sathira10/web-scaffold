---
import { site } from "@/data/site";
import { inOrder } from "@/lib/parts";
import { isCurrent } from "@/lib/routes";

const path = Astro.url.pathname;
const end = inOrder(import.meta.glob("../parts/header-end/*.astro", { eager: true }));
---

<header class="border-b border-line">
  <nav
    class="flex wrap flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2"
    aria-label="Main"
  >
    <a href="/" class="inline-flex min-h-11 items-center font-heading text-lg font-bold">
      {site.name}
    </a>
    <ul class="flex flex-wrap items-center gap-x-6">
      {site.nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center hover:text-accent aria-[current=page]:font-bold"
            aria-current={isCurrent(path, item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      {end.map((Part) => (
        <li>
          <Part />
        </li>
      ))}
    </ul>
  </nav>
</header>
