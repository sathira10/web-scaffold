---
import { existsSync } from "node:fs";
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import { has, inOrder } from "@/lib/parts";
import { routePath } from "@/lib/routes";
import { seo, serializeJsonLd, type SeoInput } from "@/lib/seo";

interface Props extends SeoInput {
  jsonLd?: Record<string, unknown>[];
}

const { jsonLd = [], ...input } = Astro.props;
// Files in public/ are checked at build time, so a link is only written when its file exists.
const inPublic = (path: string) => existsSync(`public${path}`);
const page = seo({
  ...input,
  path: input.path ?? routePath(Astro.url.pathname),
  image: input.image ?? (inPublic(site.ogImage) ? site.ogImage : undefined),
});

const headParts = import.meta.glob("../parts/head/*.astro", { eager: true });
const head = inOrder(headParts);
const bodyStart = inOrder(import.meta.glob("../parts/body-start/*.astro", { eager: true }));
const bodyEnd = inOrder(import.meta.glob("../parts/body-end/*.astro", { eager: true }));
// The dark-theme module sets its own color-scheme; without it the site is light only.
const themed = has(headParts, "theme");
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!themed && <meta name="color-scheme" content="light" />}
    <title>{page.title}</title>
    <link rel="canonical" href={page.canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {inPublic("/apple-touch-icon.png") && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {inPublic("/site.webmanifest") && <link rel="manifest" href="/site.webmanifest" />}
    {head.map((Part) => <Part />)}
    {page.meta.map((tag) =>
      tag.name ? (
        <meta name={tag.name} content={tag.content} />
      ) : (
        <meta property={tag.property} content={tag.content} />
      ),
    )}
    {[...page.jsonLd, ...jsonLd].map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
  </head>
  <body class="min-h-svh bg-bg text-fg">
    {bodyStart.map((Part) => <Part />)}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface-raised focus:p-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {bodyEnd.map((Part) => <Part />)}
  </body>
</html>
