---
import { render } from "astro:content";
import "@/styles/prose.css";
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import { formatDate, publishedPosts } from "@/lib/posts";
import { breadcrumbJsonLd } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  type="article"
  jsonLd={[
    breadcrumbJsonLd([
      { name: "Blog", path: "/blog" },
      { name: post.data.title, path },
    ]),
  ]}
>
  <article class="mx-auto max-w-prose px-4 py-16">
    <h1 class="text-h1 font-bold">{post.data.title}</h1>
    <p class="mt-2 text-small text-fg-muted">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, site.locale)}</time>
    </p>
    <div class="prose-content mt-8">
      <Content />
    </div>
  </article>
</Base>
