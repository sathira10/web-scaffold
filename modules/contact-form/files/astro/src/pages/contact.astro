---
import Base from "@/layouts/Base.astro";
import ContactForm from "@/components/ContactForm.astro";
import { site } from "@/data/site";
---

<Base title="Contact" path="/contact">
  <section class="mx-auto max-w-prose px-4 py-16">
    <h1 class="text-h1 font-bold">Contact</h1>
    <div class="mt-8">
      <ContactForm />
    </div>
    <p class="mt-8 text-fg-soft">
      Or email
      <a class="underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</Base>
