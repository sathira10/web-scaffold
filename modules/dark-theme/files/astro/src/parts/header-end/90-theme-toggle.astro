---
// Dark-theme module. Without JavaScript the button stays hidden and the system setting applies.
---

<button
  type="button"
  hidden
  data-theme-toggle
  aria-label="Use the dark theme"
  class="inline-flex size-11 items-center justify-center rounded-md hover:bg-surface"
>
  <span data-icon="moon">
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
    </svg>
  </span>
  <span data-icon="sun" hidden>
    <svg
      class="size-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      />
    </svg>
  </span>
</button>

<script>
  // public/theme.js applies a saved choice before first paint. This flips it and saves it.
  const root = document.documentElement;
  const system = window.matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : system.matches);

  function render() {
    const dark = isDark();
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.hidden = false;
      button.setAttribute("aria-label", dark ? "Use the light theme" : "Use the dark theme");
      button.querySelector<HTMLElement>('[data-icon="moon"]')?.toggleAttribute("hidden", dark);
      button.querySelector<HTMLElement>('[data-icon="sun"]')?.toggleAttribute("hidden", !dark);
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage blocked: the choice lasts for this page only.
      }
      render();
    });
  }
  system.addEventListener("change", render);
  render();
</script>
