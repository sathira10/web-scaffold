---
// Stands in for media nobody has supplied yet (a photo, a video, a map). Every use belongs in
// the open items, so it gets replaced before launch. The symbol says what will go here.
interface Props {
  label: string;
  /** Accessible description, e.g. "Photo to come: the team at work". */
  description: string;
  kind?: "photo" | "video" | "map";
  ratio?: "3/2" | "16/9" | "1/1";
}

const { label, description, kind = "photo", ratio = "3/2" } = Astro.props;
const ratios = { "3/2": "aspect-[3/2]", "16/9": "aspect-video", "1/1": "aspect-square" };
---

<div
  role="img"
  aria-label={description}
  class:list={["box-border flex flex-col bg-accent-soft p-5 text-small text-fg-soft", ratios[ratio]]}
>
  <svg
    aria-hidden="true"
    class="m-auto size-16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {
      kind === "video" ? (
        <>
          <circle cx="12" cy="12" r="10" />
          <path d="M10 8.5v7l6-3.5z" />
        </>
      ) : kind === "map" ? (
        <>
          <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
          <circle cx="12" cy="9.5" r="2.5" />
        </>
      ) : (
        <>
          <rect x="3" y="6" width="18" height="14" rx="1" />
          <path d="M8 6l1.5-2h5L16 6" />
          <circle cx="12" cy="13" r="3.5" />
        </>
      )
    }
  </svg>
  <span>{label}</span>
</div>
