  "holds": {
    "typescript": {
      "reason": "typescript-eslint and @astrojs/check don't support TypeScript 7 yet. Held at 6.0 because typescript-eslint stops below 6.1.",
      "blockedBy": ["typescript-eslint", "@astrojs/check"]
    },
    "@types/node": {
      "reason": "Matches the Node LTS in .nvmrc (node.lts), not the newest Node types.",
      "follows": "node.lts"
    }
  },
  "overrides": {
    "@emnapi/core": {
      "version": "1.11.3",
      "frameworks": ["astro"],
      "reason": "@astrojs/check's wasm runtime resolves @emnapi/runtime to a 2.0 beta that crashes `astro check`. Drop once a stable 2.x lands."
    },
    "@emnapi/runtime": {
      "version": "1.11.3",
      "frameworks": ["astro"],
      "reason": "See @emnapi/core."
    },
    "minimatch@^10": {
      "version": "^11.0.1",
      "modules": ["quality"],
      "reason": "ESLint 10 depends on minimatch 10, which has GHSA-g3hv-75wg-m249 (fixed only in 11.0.1). Drop when eslint moves to minimatch 11."
    },
    "@esbuild-kit/core-utils>esbuild": {
      "version": "^0.25.4",
      "modules": ["d1"],
      "reason": "drizzle-kit 0.31 loads configs through the deprecated @esbuild-kit, pinned to esbuild 0.18 (GHSA-67mh-4wv8-2f99). Matches drizzle-kit's own esbuild. Drop with drizzle-kit 1.0."
    }
  },
  "auditIgnore": []
